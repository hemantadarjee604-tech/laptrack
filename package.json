{
  "name": "labtrack",
  "version": "1.0.0",
  "description": "LabTrack - Science Laboratory Inventory Management System with request portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
